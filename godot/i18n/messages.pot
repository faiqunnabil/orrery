#: data/body_info.json
msgid "Nearly circular orbit with an eccentricity of 0.0068."
msgstr ""

#: data/body_info.json
msgid "Neptune is a deep blue planet at the edge of the solar system. It is cold, dark, and very windy."
msgstr ""

#: data/body_info.json
msgid "Olympus Mons, a volcano about 22 km tall, is the tallest in the solar system."
msgstr ""

#: data/body_info.json
msgid "One solar day lasts about 176 Earth days, twice its orbital period."
